# Copy to .env for local development with `vercel dev`.
# .env is git-ignored. In production these are set as Vercel environment
# variables, never committed and never exposed to the browser.

# Required. The server-side AI key. Read only inside /api functions via
# process.env — it must never appear in /public or in a response body.
ANTHROPIC_API_KEY=

# Optional. Thinking depth and token spend for /api/summarize.
# One of: low | medium | high | xhigh | max. Defaults to medium.
SHEPHERD_EFFORT=

# Optional. Set to 1 to serve the stored example summaries instead of calling
# the model — offline demo rehearsal. Responses are marked X-Shepherd-Stub: 1.
SHEPHERD_USE_FIXTURES=
